# ATLAS LLM Server configuration
# Copy this file to .env, then replace the placeholder with the key supplied via PEAR.
ATLAS_API_KEY=YOUR_PEAR_API_KEY_HERE
ATLAS_API_URL=https://sequitor01.atlas.illinois.edu/v1/chat/completions

# Model parameters from UIUCATLAS/chat_illinois_cli
ATLAS_MODEL=qwen3.8-27b
ATLAS_TEMPERATURE=0.1
# Allowed by the current server configuration: low, medium, xhigh
ATLAS_REASONING_EFFORT=low
ATLAS_USE_LAST_RESPONSE=false

# The system prompt is instructions + a newline + the Markdown knowledge base.
# Relative paths are resolved from the project root.
ATLAS_INSTRUCTIONS_FILE=config/instructions.txt
ATLAS_KNOWLEDGE_BASE_FILE=config/knowledgebase.md
ATLAS_TIMEOUT_SECONDS=60

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=True
